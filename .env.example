# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git, токен храните только в нём.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую, например: 123456789,987654321
ADMIN_IDS=

# Путь к файлу базы данных SQLite
DB_PATH=data/bot.db

# 1 = объявления публикуются сразу, 0 = сначала проверка администратором
AUTO_APPROVE=0

# Mini App (веб-приложение внутри Telegram), необязательно.
# Публичный HTTPS-адрес, по которому открывается сервер, например https://abc.trycloudflare.com
WEBAPP_URL=
# Порт, на котором слушает сервер Mini App
PORT=8000
